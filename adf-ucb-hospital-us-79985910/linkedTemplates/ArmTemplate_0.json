{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ucb-hospital-us-79985910"
		},
		"ls_dw_hospital_sql_password": {
			"type": "secureString",
			"metadata": "Cadena protegida para \"password\"de \"ls_dw_hospital_sql\""
		},
		"ls_dw_hospital_sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sql-ucb-server-hospital-79985910.database.windows.net"
		},
		"ls_dw_hospital_sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "dw_hospital"
		},
		"ls_dw_hospital_sql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "victor"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/ls_dw_hospital_sql')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureSqlDatabase",
				"typeProperties": {
					"server": "[parameters('ls_dw_hospital_sql_properties_typeProperties_server')]",
					"database": "[parameters('ls_dw_hospital_sql_properties_typeProperties_database')]",
					"encrypt": "mandatory",
					"trustServerCertificate": false,
					"authenticationType": "SQL",
					"userName": "[parameters('ls_dw_hospital_sql_properties_typeProperties_userName')]",
					"password": {
						"type": "SecureString",
						"value": "[parameters('ls_dw_hospital_sql_password')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}