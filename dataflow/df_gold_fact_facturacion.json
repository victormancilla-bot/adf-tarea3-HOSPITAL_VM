{
	"name": "df_gold_fact_facturacion",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_silver_billing_sql",
						"type": "DatasetReference"
					},
					"name": "srcsilverbilling"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "srcsilveradmissions"
				},
				{
					"dataset": {
						"referenceName": "dw_gold_dim_paciente_sql",
						"type": "DatasetReference"
					},
					"name": "srcdimpaciente"
				},
				{
					"dataset": {
						"referenceName": "dw_gold_dim_departamento_sql",
						"type": "DatasetReference"
					},
					"name": "srcdimdepartamento"
				},
				{
					"dataset": {
						"referenceName": "dw_gold_dim_servicio_cargo_sql",
						"type": "DatasetReference"
					},
					"name": "srcdimserviciocargo"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_gold_fact_facturacion_sql",
						"type": "DatasetReference"
					},
					"name": "sinkfactfacturacion"
				}
			],
			"transformations": [
				{
					"name": "dcmetricasfact"
				},
				{
					"name": "lkpsilveradm"
				},
				{
					"name": "lkppaciente"
				},
				{
					"name": "lkpdepartamento"
				},
				{
					"name": "lkpserviciocargo"
				},
				{
					"name": "fltfactfact"
				},
				{
					"name": "arfactfact"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcsilverbilling",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcsilveradmissions",
				"source(output(",
				"          paciente_key as integer,",
				"          patient_id_bk as integer,",
				"          nombre_completo as string,",
				"          genero as string,",
				"          fecha_nacimiento as date,",
				"          rango_etario as string,",
				"          correo_electronico as string,",
				"          direccion as string,",
				"          proveedor_seguro as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcdimpaciente",
				"source(output(",
				"          departamento_key as integer,",
				"          nombre_departamento as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcdimdepartamento",
				"source(output(",
				"          servicio_cargo_key as integer,",
				"          tipo_cargo as string,",
				"          estado_pago as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcdimserviciocargo",
				"srcsilverbilling derive(billing_id_bk = billing_id,",
				"          admission_id_bk = admission_id,",
				"          fecha_pago_key = iif(isNull(payment_date), toInteger(null()), toInteger(year(payment_date) * 10000 + month(payment_date) * 100 + dayOfMonth(payment_date))),",
				"          monto_facturado = amount,",
				"          conteo_transacciones = 1) ~> dcmetricasfact",
				"dcmetricasfact, srcsilveradmissions lookup(srcsilverbilling@admission_id == srcsilveradmissions@admission_id,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkpsilveradm",
				"lkpsilveradm, srcdimpaciente lookup(patient_id == patient_id_bk,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkppaciente",
				"lkppaciente, srcdimdepartamento lookup(department == nombre_departamento,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkpdepartamento",
				"lkpdepartamento, srcdimserviciocargo lookup(charge_type == tipo_cargo",
				"     && payment_status == estado_pago,",
				"     multiple: false,",
				"     pickup: 'any',",
				"     broadcast: 'auto')~> lkpserviciocargo",
				"lkpserviciocargo filter(!isNull(paciente_key) && !isNull(departamento_key) && !isNull(servicio_cargo_key)) ~> fltfactfact",
				"fltfactfact alterRow(upsertIf(true())) ~> arfactfact",
				"arfactfact sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          facturacion_key as long,",
				"          billing_id_bk as integer,",
				"          admission_id_bk as integer,",
				"          paciente_key as integer,",
				"          departamento_key as integer,",
				"          servicio_cargo_key as integer,",
				"          fecha_pago_key as integer,",
				"          monto_facturado as decimal(12,2),",
				"          conteo_transacciones as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['billing_id_bk'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          billing_id_bk,",
				"          admission_id_bk,",
				"          paciente_key,",
				"          departamento_key,",
				"          servicio_cargo_key,",
				"          fecha_pago_key,",
				"          monto_facturado,",
				"          conteo_transacciones",
				"     )) ~> sinkfactfacturacion"
			]
		}
	}
}