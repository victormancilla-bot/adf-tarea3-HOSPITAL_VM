{
	"name": "df_silver_admissions",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bronze_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "srcbronzeadmissions"
				},
				{
					"dataset": {
						"referenceName": "dw_silver_patients_sql",
						"type": "DatasetReference"
					},
					"name": "srcsilverpatients"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_admissions_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "dclimpiezaadmissions"
				},
				{
					"name": "dcvalidaralta"
				},
				{
					"name": "fltvalidadmissions"
				},
				{
					"name": "expatientexists"
				},
				{
					"name": "select1"
				},
				{
					"name": "arupsertadmissions"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcbronzeadmissions",
				"source(output(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcsilverpatients",
				"srcbronzeadmissions derive(admission_id = toInteger(trim(admission_id)),",
				"          patient_id = toInteger(trim(patient_id)),",
				"          attending_doctor_id = toInteger(trim(attending_doctor_id)),",
				"          admission_date = coalesce(toDate(trim(admission_date), 'yyyy-MM-dd'), toDate(trim(admission_date), 'MM/dd/yyyy'), toDate(trim(admission_date), 'dd-MMM-yyyy'), toDate(trim(admission_date), 'MMMM dd, yyyy'), toDate(trim(admission_date), 'MM-dd-yy')),",
				"          discharge_raw = coalesce(toDate(trim(discharge_date), 'yyyy-MM-dd'), toDate(trim(discharge_date), 'MM/dd/yyyy'), toDate(trim(discharge_date), 'dd-MMM-yyyy'), toDate(trim(discharge_date), 'MMMM dd, yyyy'), toDate(trim(discharge_date), 'MM-dd-yy')),",
				"          department = case(startsWith(lower(trim(department)), 'cardio'), 'Cardiology', startsWith(lower(trim(department)), 'emerg') || lower(trim(department)) == 'er', 'Emergency', startsWith(lower(trim(department)), 'gen'), 'General Surgery', startsWith(lower(trim(department)), 'neuro') || startsWith(lower(trim(department)), 'nuero'), 'Neurology', startsWith(lower(trim(department)), 'onco'), 'Oncology', startsWith(lower(trim(department)), 'ortho'), 'Orthopedics', startsWith(lower(trim(department)), 'ped') || startsWith(lower(trim(department)), 'paed'), 'Pediatrics', trim(department))) ~> dclimpiezaadmissions",
				"dclimpiezaadmissions derive(discharge_date = iif(isNull(discharge_raw) || isNull(admission_date) || discharge_raw < admission_date, toDate(null()), discharge_raw)) ~> dcvalidaralta",
				"dcvalidaralta filter(!isNull(admission_id) && !isNull(patient_id) && !isNull(admission_date) && !isNull(attending_doctor_id)) ~> fltvalidadmissions",
				"fltvalidadmissions, srcsilverpatients exists(dclimpiezaadmissions@patient_id == srcsilverpatients@patient_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> expatientexists",
				"expatientexists select(mapColumn(",
				"          admission_id,",
				"          patient_id,",
				"          admission_date,",
				"          discharge_date,",
				"          department,",
				"          attending_doctor_id",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 alterRow(upsertIf(true())) ~> arupsertadmissions",
				"arupsertadmissions sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['admission_id'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id,",
				"          patient_id,",
				"          admission_date,",
				"          discharge_date,",
				"          department,",
				"          attending_doctor_id",
				"     )) ~> sink1"
			]
		}
	}
}