{
	"name": "df_gold_dim_servicio_cargo",
	"properties": {
		"folder": {
			"name": "gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_silver_billing_sql",
						"type": "DatasetReference"
					},
					"name": "srcsilverbilling"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_gold_dim_servicio_cargo_sql",
						"type": "DatasetReference"
					},
					"name": "sinkdimserviciocargo"
				}
			],
			"transformations": [
				{
					"name": "aggserviciocargo"
				},
				{
					"name": "selserviciocargo"
				},
				{
					"name": "arserviciocargo"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcsilverbilling",
				"srcsilverbilling aggregate(groupBy(charge_type,",
				"          payment_status),",
				"     conteo_temp = count(billing_id)) ~> aggserviciocargo",
				"aggserviciocargo select(mapColumn(",
				"          tipo_cargo = charge_type,",
				"          estado_pago = payment_status",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selserviciocargo",
				"selserviciocargo alterRow(upsertIf(true())) ~> arserviciocargo",
				"arserviciocargo sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          servicio_cargo_key as integer,",
				"          tipo_cargo as string,",
				"          estado_pago as string",
				"     ),",
				"     deletable:false,",
				"     insertable:false,",
				"     updateable:false,",
				"     upsertable:true,",
				"     keys:['tipo_cargo','estado_pago'],",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          tipo_cargo,",
				"          estado_pago",
				"     )) ~> sinkdimserviciocargo"
			]
		}
	}
}